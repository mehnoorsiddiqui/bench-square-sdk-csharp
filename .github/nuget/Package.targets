<Project>

    <!--
        NuGet package metadata for the SDK. It lives outside the generated SDK tree so that
        regenerating the SDK does not wipe it; the publish workflow injects it with
        -p:CustomAfterMicrosoftCommonTargets=<path to this file>.

        The package id is not "Square": that id belongs to Square's own SDK on nuget.org.
        The root namespace and client stay Square / SquareClient.
    -->

    <PropertyGroup>
        <PackageId>ApimaticBench.Square</PackageId>
        <Authors>mehnoorsiddiqui</Authors>
        <Description>APIMatic-generated .NET SDK for the Square API, one version per real Square API release (benchmark build, not Square's official SDK).</Description>
        <PackageTags>square;payments;sdk;apimatic;benchmark</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/mehnoorsiddiqui/bench-square-sdk-csharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/mehnoorsiddiqui/bench-square-sdk-csharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

</Project>
